/*
 * scrnaseq-lite - Nextflow configuration.
 *
 * Hard-coded settings, environment and profiles only. Run-variable
 * scientific parameters live in params/default.yaml, which is NOT loaded
 * automatically: every run must pass `-params-file <file>`.
 *
 *   nextflow run . -profile docker -params-file params/default.yaml
 */

params {
    // Names this run. When null, a timestamp is used instead.
    //
    // Set ONLY on the command line, with `--run <name>`. It must never
    // appear in a params file: every run sharing that file would then
    // write into the same output directory.
    //
    // IMPORTANT: the timestamp below is re-evaluated at every launch, so
    // `-resume` only yields a coherent output directory when `--run` is
    // given. See docs/usage.md.
    run = null

    // Derived, not user-facing: the single definition of this run's output
    // directory. Do not set it, and do not put it in a params file.
    //
    // It has to be a param rather than a local variable because Nextflow's
    // config parser accepts neither a `def` declaration nor a reference to
    // `outputDir` from a later statement. Both are hard parse errors, so
    // `params` is the only scope readable by `outputDir` and by the four
    // trace blocks alike. Evaluating the timestamp in five places instead
    // would risk five different values across a second boundary.
    //
    // This is also the nf-core convention rather than a local invention:
    // the nf-core/tools pipeline template computes its launch timestamp
    // as `params.trace_report_suffix` inside the params block, sets
    // `outputDir = params.outdir`, and interpolates `params.outdir` in
    // its trace blocks.
    run_output_dir = params.run
        ? "results/${params.run}"
        : "results/run_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}"
}

// Base directory for the workflow `output` block. `outputDir` is a
// top-level config setting, not a param: `-output-dir` (single dash) is
// the Nextflow-level override, and there is no `--outputDir` param.
outputDir = params.run_output_dir

// Global publish mode. 'copy', never 'symlink': S3 has no symlinks and
// AWS Batch is a deployment target.
workflow.output.mode = 'copy'

includeConfig 'conf/base.config'

// Container overrides for vendored modules. Currently one, working around
// a bioconda build of alevin-fry that faults with SIGILL on CPUs below the
// build worker's. Both the file and this line go away when the installed
// simpleaf modules ship alevin-fry 0.18.1 or newer; see the file itself.
includeConfig 'conf/containers.config'

// Per-process arguments and the chemistry mapping. Included after
// conf/containers.config so both apply to the same processes; they set
// disjoint keys, so the order is for readability, not precedence.
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled      = true
        // Run as the invoking user so published files are not root-owned.
        docker.runOptions   = '-u $(id -u):$(id -g)'
        conda.enabled       = false
        singularity.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }
    // Small remote nf-core test data. Exercises the DAG in minutes.
    // Results are NOT biologically meaningful.
    test     { includeConfig 'conf/test.config' }
    // Local downsampled human PBMC data. The presentable run.
    demo     { includeConfig 'conf/demo.config' }
    awsbatch { includeConfig 'conf/aws.config'  }
}

// Environment-specific AWS settings (account IDs, buckets, queues, ARNs)
// stay out of version control. See conf/aws.config.
//
// The existence test uses projectDir, not a bare relative path: a bare
// path would be resolved against the launch directory, so the file would
// be silently skipped whenever the pipeline is launched from elsewhere.
// `file()` is not available to the config parser; `new File` is.
includeConfig new File("${projectDir}/conf/aws.local.config").exists()
    ? "${projectDir}/conf/aws.local.config"
    : '/dev/null'

env {
    // Prevent host Python site-packages leaking into containers, which
    // would silently change the Scanpy stack out from under the pins.
    PYTHONNOUSERSITE = 1
}

// -C ignores the container image's bash startup files; -e -u -o pipefail
// make a failing step in a pipe fail the task instead of passing quietly.
process.shell = ['bash', '-C', '-e', '-u', '-o', 'pipefail']

// Execution provenance (R12.3). The engine writes these four itself, so
// they cannot go through the workflow `output` block and must name their
// destination directly.
//
// `overwrite = true` is required, not cosmetic: a resumed run reuses the
// same directory by definition, and without it Nextflow refuses to
// rewrite these four files and the run ends with a warning and stale
// provenance. Resume with `--run <name>` is a supported workflow here.
timeline { enabled = true ; overwrite = true ; file = "${params.run_output_dir}/pipeline_info/execution_timeline.html" }
report   { enabled = true ; overwrite = true ; file = "${params.run_output_dir}/pipeline_info/execution_report.html"   }
trace    { enabled = true ; overwrite = true ; file = "${params.run_output_dir}/pipeline_info/execution_trace.txt"     }
dag      { enabled = true ; overwrite = true ; file = "${params.run_output_dir}/pipeline_info/pipeline_dag.html"       }

manifest {
    name            = 'scrnaseq-lite'
    description     = 'Minimal core-steps single-cell RNA-seq pipeline'
    // `contributors` supersedes the older `author` field, which Nextflow
    // deprecated in 24.10.0.
    contributors    = [
        [ name: 'Andreas Leimbach', contribution: ['author', 'maintainer'] ]
    ]
    homePage        = 'https://github.com/aleimba/scrnaseq-lite'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.0'
    version         = '0.1.0'
}

plugins {
    // nf-schema only. nf-validation is its superseded predecessor and the
    // two conflict if both are declared.
    id 'nf-schema@2.8.0'
}
