/*
 * scrnaseq-lite - AWS Batch profile (requirement R14.2).
 *
 * Portable settings only. This file is tracked in a public repository and
 * therefore contains no region, queue name, bucket, account ID or ARN.
 *
 * Environment-specific values go in conf/aws.local.config, which is
 * gitignored and included automatically by nextflow.config when present.
 * That file supplies exactly four things:
 *
 *   aws.region              = '<region>'
 *   process.queue           = '<batch-job-queue>'
 *   workDir                 = 's3://<bucket>/work'
 *   aws.batch.jobRole       = '<job-role-arn>'      // if the queue needs one
 *
 * The work directory must be on S3: with awsbatch there is no shared
 * filesystem between the head node and the compute environment.
 *
 * Deviation from "Design section 11: AWS readiness", which describes
 * region, queue and work directory as pipeline params with no values.
 * They are native Nextflow config settings, and every params file in this
 * pipeline is a complete parameter set, so exposing them as params would
 * force deployment settings into params/default.yaml and params/demo.yaml
 * and into every future params file. They stay in the config scope where
 * Nextflow expects them.
 */

process {
    executor = 'awsbatch'
}

aws {
    batch {
        // Retry Spot interruptions inside Batch rather than failing the
        // task, which would consume one of the two attempts allowed by
        // conf/base.config.
        maxSpotAttempts = 3
    }
}

// Wave plus Fusion is the currently recommended way to reach S3 from
// Batch. It removes the need for an AWS CLI baked into a custom AMI:
// aws.batch.cliPath is documented as a legacy requirement and is
// deliberately not set here.
wave {
    enabled = true
}

fusion {
    enabled = true
}
