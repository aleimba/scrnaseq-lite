/*
 * scrnaseq-lite - `test` profile: engine settings only.
 *
 *   nextflow run . -profile test,docker -params-file params/test.yaml
 *
 * Every params.* value for this profile lives in params/test.yaml, which
 * is a complete parameter set. Nothing here sets a param, so no value is
 * defined in two places and the precedence of `-params-file` against
 * config-defined params never has to be reasoned about.
 *
 * WHAT THIS PROFILE IS FOR: exercising the DAG cheaply after every task,
 * on the small remote nf-core/test-datasets fixture. Its results are NOT
 * biologically meaningful. See the header of params/test.yaml for the
 * known ceiling at the cell-calling step.
 */

process {
    // Matches the caps nf-core/scrnaseq uses for this same dataset in its
    // own CI, so a green run here means the same thing it means there.
    resourceLimits = [
        cpus  : 2,
        memory: 6.GB,
        time  : 2.h
    ]
}
