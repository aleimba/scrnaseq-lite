/*
 * scrnaseq-lite - `demo` profile: engine settings only.
 *
 *   nextflow run . -profile demo,docker -params-file params/demo.yaml --run demo01
 *
 * Every params.* value for this profile lives in params/demo.yaml, which
 * is a complete parameter set. Nothing here sets a param.
 *
 * WHAT THIS PROFILE IS FOR: the presentable run, on local downsampled
 * human PBMC data (10x pbmc_1k_v3 and pbmc_10k_v3). The FASTQs it needs
 * are produced by bin/download_and_downsample_testdata.sh at task T5.2,
 * and the splici index is built once beforehand; see params/demo.yaml.
 */

process {
    // Requirement R14.4: the demo must complete on 2 CPUs and 8 GB in
    // under 20 minutes. This is the cap conf/base.config deliberately
    // leaves out, because a cap belongs with the profile that knows the
    // machine rather than with the labels that state what a task needs.
    resourceLimits = [
        cpus  : 2,
        memory: 8.GB,
        time  : 1.h
    ]
}
