/*
 * scrnaseq-lite - per-process arguments and the chemistry mapping.
 *
 * Contains ext.args, ext.prefix, `scratch`, and the one lookup table that
 * ties the samplesheet chemistry to everything derived from it. Nothing
 * else: resource labels are in conf/base.config, container overrides in
 * conf/containers.config, run-variable values in params/*.yaml.
 *
 * NO publishDir anywhere. Publishing is declared in the entry workflow's
 * `publish:` section and the `output` block in main.nf.
 *
 * A flag a vendored module already hard-codes must NOT be repeated here;
 * simpleaf and QCatch both reject a repeated argument. Confirmed at T2.1
 * against the installed modules:
 *   simpleaf/quant hard-codes --anndata-out
 *   qcatch         hard-codes --save_filtered_h5ad and --export_summary_table
 *   both simpleaf modules do `export ALEVIN_FRY_HOME=.` and
 *   `simpleaf set-paths` themselves, and index also does `ulimit -n 2048`
 */

params {
    // ONE SOURCE OF TRUTH. The samplesheet `chemistry` column selects the
    // simpleaf chemistry, the QCatch chemistry AND the barcode whitelist
    // together. They must never be settable apart: a run whose whitelist
    // disagrees with its chemistry produces a plausible-looking, wrong
    // matrix rather than an error.
    //
    // The subworkflows read this map; it cannot live in `ext.args`, because
    // both SIMPLEAF_QUANT and QCATCH take the chemistry as a channel VALUE
    // (`tuple val(meta), val(chemistry), ...`), not as an argument string.
    // It is a params entry rather than a `def` because a `def` at config
    // top level is a hard parse error, and `params` is the only scope
    // workflow code can read. Like `run_output_dir` in nextflow.config it
    // is derived, not user-facing: it must never appear in a params file.
    //
    // VERIFIED at T2.1 by running, in the pinned containers, rather than
    // taken from documentation:
    //   `simpleaf chemistry lookup -n ".*"` registers 10xv2, 10xv3 and
    //   10xv4-3p. There is NO `10xv4` entry - note the -3p suffix.
    //   `qcatch --help` accepts 10X_3p_v2, 10X_3p_v3 and 10X_3p_v4.
    // Whitelist file names are those vendored in assets/whitelist/; see
    // that directory's README.md for provenance and checksums.
    //
    // `r1_len` is the expected R1 length that `ASSERT_R1_LENGTH` enforces
    // (R1.5), and it belongs here for the same reason as the rest: it is
    // derived from the chemistry and must not be settable apart from it.
    // 26 = 16 bp barcode + 10 bp UMI for v2; 28 = 16 + 12 for v3 and v4.
    // The UMI lengths are the registered simpleaf geometries, checked at
    // T2.1 - the v2 UMI is 10 bp, not 12.
    chemistry_map = [
        '10XV2': [ simpleaf: '10xv2'   , qcatch: '10X_3p_v2', whitelist: '10x_V2_barcode_whitelist.txt.gz', r1_len: 26 ],
        '10XV3': [ simpleaf: '10xv3'   , qcatch: '10X_3p_v3', whitelist: '10x_V3_barcode_whitelist.txt.gz', r1_len: 28 ],
        '10XV4': [ simpleaf: '10xv4-3p', qcatch: '10X_3p_v4', whitelist: '10x_V4_barcode_whitelist.txt.gz', r1_len: 28 ]
    ]
}

process {

    withName: SEQKIT_STATS {
        // The module already passes --tabular. --all adds the quartile and
        // N50 columns; the R1 modal-length assertion (R1.5) reads its
        // output, so the extra columns cost nothing and help a human
        // reading the same file.
        ext.args = '--all'
    }

    withName: FASTP {
        // REPORT ONLY. R1 is 26 bp (v2) or 28 bp (v3/v4) of cell barcode
        // plus UMI at fixed offsets, and adapter-, quality- or
        // length-trimming it would shift those offsets and corrupt every
        // barcode. These three flags are what makes fastp a measurement
        // rather than a filter. Its read outputs are not consumed: the
        // quantifier reads the original FASTQs.
        //
        // Consequence, accepted deliberately: no poly-G trimming is applied
        // anywhere in this pipeline. Poly-G reads simply fail to map in
        // piscem. fastp's own poly-G handling affects only the numbers in
        // its report, because the reads it writes are discarded.
        //
        // The module additionally hard-codes --detect_adapter_for_pe in its
        // paired-end branch. Verified at T2.1 that it is inert alongside
        // --disable_adapter_trimming: fastp 1.3.6 exits 0 and still writes
        // both reports.
        ext.args = '--disable_adapter_trimming --disable_quality_filtering --disable_length_filtering'
    }

    withName: SIMPLEAF_INDEX {
        // piscem opens very many intermediate files while indexing and
        // stalls or fails opaquely on I/O-limited nodes, notably on AWS.
        // `scratch` is all this pipeline adds: the module raises the
        // open-file limit and exports ALEVIN_FRY_HOME in its own script.
        scratch = true

        // --rlen is the flank length roers adds to intronic sequence when
        // building the splici reference, so it must match the cDNA read
        // length of the data the index will be used on. The module does not
        // pass it; without this the tool's own default silently applies.
        //
        // --ram-limit-gib caps SSHash's external minimizer sort. simpleaf
        // 0.30.0 defaults it to 8 GiB, which is more than the `test`
        // profile's whole resourceLimits allowance, so it is derived from
        // what this task was actually granted. 75% leaves headroom for the
        // rest of the build; toGiga() is integer division, so a task under
        // 2 GB floors to 1 rather than 0.
        //
        // NOT passed: --use-piscem. simpleaf 0.30.0 has no mapper flag at
        // all - piscem is the only backend (T2.2 finding 1). Supplying
        // --fasta together with --gtf is still what selects the splici
        // strategy; --ref-type already defaults to spliced+intronic.
        ext.args = { "--rlen ${params.r2_read_length} --ram-limit-gib ${Math.max(1L, (long) (task.memory.toGiga() * 0.75))}" }
    }

    withName: SIMPLEAF_QUANT {
        // Deliberately no ext.args, and that is a finding rather than an
        // omission. Everything this step needs arrives another way:
        //   --anndata-out            hard-coded in the module
        //   --chemistry, --index,
        //   --t2g-map, --reads1/2,
        //   --unfiltered-pl <file>,
        //   --resolution             module INPUTS, from the workflow
        // Adding any of them here would pass the argument twice.
        //
        // --min-reads stays at simpleaf's default of 10, chosen rather than
        // inherited: under --unfiltered-pl it decides which barcodes become
        // matrix rows at all (R5.2). Lowering it is the lever for a fixture
        // too sparse to call cells on, and that decision belongs to T2.5
        // with a measured barcode count in hand, not here.
    }

    withName: QCATCH {
        // --skip_umap_tsne: we compute UMAP ourselves, seeded, in Scanpy.
        //
        // NOT passed, and never to be added: --remove_doublets and
        // --visualize_doublets. QCatch's Scrublet run exposes no seed, so
        // doublets are detected in an explicit seeded Scanpy step where the
        // parameters are visible in the DAG.
        //
        // --save_filtered_h5ad and --export_summary_table are hard-coded in
        // the module and must not be repeated.
        //
        // --n_partitions is for custom or unsupported chemistries only: it
        // overrides the chemistry-based configuration of the empty-drops
        // step, so it is passed only when a user has explicitly set it.
        ext.args = params.qcatch_n_partitions ? "--skip_umap_tsne --n_partitions ${params.qcatch_n_partitions}" : '--skip_umap_tsne'
    }

    withName: MULTIQC {
        // The report title is run-variable, so it comes from the params
        // file. It is set here rather than in assets/multiqc_config.yaml so
        // the value lives in exactly one place.
        //
        // Guarded, and not defensively for its own sake: params files are
        // not loaded automatically, so an unguarded interpolation puts the
        // literal string 'null' on the report of anyone who forgets
        // -params-file. Verified by resolving this config without one.
        ext.args = params.multiqc_title ? "--title '${params.multiqc_title}'" : ''
    }
}
