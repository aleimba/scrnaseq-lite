/*
 * scrnaseq-lite - resource labels and error handling.
 *
 * Labels only. Per-process arguments live in conf/modules.config, and
 * run-variable parameters in params/default.yaml.
 *
 * Deliberately NO `resourceLimits` here. A limit is a cap on what the
 * machine can give, not a statement of what a task needs, so it belongs
 * with the profile that knows the machine: conf/demo.config caps at
 * 2 CPUs / 8 GB for requirement R14.4. Setting a cap here as well would
 * put the same value in two files.
 *
 * The requests below are smaller than the nf-core template's, on purpose.
 * This pipeline's heaviest step is simpleaf indexing, and the full human
 * 2024-A splici index is around 2 GB with piscem mapping in under about
 * 3 GB of RAM. Sizing `process_high` at the template's 72 GB would make
 * tasks unschedulable on an ordinary workstation while buying nothing.
 */

process {

    cpus   = 1
    memory = 2.GB
    time   = 2.h

    // Retry only on the exit codes that mean "killed for resources"
    // (130 SIGINT, 137 SIGKILL/OOM, 140 SIGUSR2/scheduler limit,
    // 143 SIGTERM), with more memory each attempt. Anything else is a
    // real error and retrying it just wastes time.
    //
    // 'finish' rather than 'terminate': let running tasks complete so
    // partial results still publish and the failure is diagnosable.
    errorStrategy = { task.exitStatus in [130, 137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 1   // 2 attempts in total, per design section 9
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // Carried for compatibility with the vendored nf-core modules, which
    // may declare it. Nothing in this pipeline is expected to need it.
    withLabel: process_high_memory {
        memory = { 32.GB * task.attempt }
    }
    withLabel: process_long {
        time = { 12.h * task.attempt }
    }
}
